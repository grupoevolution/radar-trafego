# ===============================================
# Radar — variáveis de ambiente
# Copie para .env (local) ou cole na aba "Environment" do EasyPanel.
# ===============================================

PORT=3200

# Banco PRÓPRIO do Radar (crie um Postgres novo no EasyPanel só pra ele)
DATABASE_URL=postgres://usuario:senha@host:5432/radar

# Banco do APP DE MEMBROS — SÓ LEITURA. Use um usuário read-only
# (ver docs/DEPLOY.md: CREATE ROLE radar_leitura ...). Deixe vazio pra não ler o app.
APP_DATABASE_URL=

# Login do painel
ADMIN_PASSWORD=troque-isso
# Segredo do cookie de login e da criptografia das chaves do Facebook (texto longo aleatório).
# NUNCA troque depois de conectar as BMs (as chaves salvas deixam de abrir).
SECRET_KEY=troque-por-um-texto-bem-longo-e-aleatorio

# Chave que o Claude usa pra ler os dados e publicar o relatório diário
CLAUDE_API_KEY=troque-por-outro-texto-longo

# Versão da API do Facebook (Graph API)
META_API_VERSION=v24.0

# 1 = dados de demonstração (pra ver o sistema funcionando antes de conectar as BMs)
DEMO_MODE=0

# Notificações no celular (Web Push). Se vazio, o Radar gera e guarda sozinho.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
